{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=your-aiven-db-host;Port=21802;Database=DB-Smart-Market;Username=your-username;Password=YOUR_AIVEN_PASSWORD_PLACEHOLDER;SSL Mode=Require;Trust Server Certificate=true"
  },
  "Jwt": {
    "Key": "your-super-secret-key-min-32-characters-long-for-hmacsha256",
    "Issuer": "STMM.API",
    "Audience": "STMM.Client",
    "AccessTokenExpireMinutes": 1440,
    "RefreshTokenExpireDays": 7
  },
  "Cloudinary": {
    "CloudName": "YOUR_CLOUD_NAME",
    "ApiKey": "YOUR_API_KEY",
    "ApiSecret": "YOUR_API_SECRET"
  },
  "Email": {
    "UseDevelopmentMock": false,
    "SmtpServer": "smtp.gmail.com",
    "Port": 587,
    "SenderEmail": "YOUR_SENDER_EMAIL",
    "SenderName": "Smart Market (STMM)",
    "Username": "YOUR_SMTP_USERNAME",
    "Password": "YOUR_SMTP_PASSWORD",
    "EnableSsl": true
  },
  "AllowedHosts": "*"
}
