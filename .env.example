# =========================================================================
# Database Configuration (PostgreSQL)
# =========================================================================
# Copy this file to '.env' and fill in your actual credentials
ConnectionStrings__DefaultConnection=Host=YOUR_HOST;Port=YOUR_PORT;Database=YOUR_DATABASE;Username=YOUR_USERNAME;Password=YOUR_PASSWORD;SSL;SSL Mode=Require;Trust Server Certificate=true

# =========================================================================
# Cloudinary Storage Configuration
# =========================================================================
Cloudinary__CloudName=YOUR_CLOUDINARY_CLOUD_NAME
Cloudinary__ApiKey=YOUR_CLOUDINARY_API_KEY
Cloudinary__ApiSecret=YOUR_CLOUDINARY_API_SECRET
